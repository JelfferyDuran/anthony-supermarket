{
  "name": "anthony-supermarket",
  "version": "1.0.0",
  "description": "Anthony's Supermarket - Unified digital presence with Three.js immersive shopping",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:*\"",
    "dev:pricing-hub": "cd apps/pricing-hub && npm run dev",
    "dev:delivery": "cd apps/delivery && npm run dev",
    "dev:menu": "cd apps/menu && npm run dev",
    "dev:command-center": "cd apps/command-center && npm run dev",
    "dev:superkitchen": "cd apps/superkitchen && npm run dev",
    "server:superkitchen": "cd apps/superkitchen/server && npm start",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "verify:pricing-hub": "node scripts/verify-pricing-hub.js",
    "verify:pricing-migrations": "node scripts/test-pricing-migrations.js",
    "seed:pricing": "node scripts/seed-pricing-from-hub.js",
    "seed:pricing:check": "node scripts/seed-pricing-from-hub.js --check",
    "test:pricing": "cd server && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "eslint": "^8.45.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
