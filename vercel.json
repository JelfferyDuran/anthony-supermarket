{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-public-site.js",
  "outputDirectory": "public-build",
  "functions": {
    "api/pricing/[...path].js": {
      "memory": 1024
    },
    "api/pricing-fn.js": {
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/pricing/:path*",
      "destination": "/api/pricing-fn?__path=:path*"
    }
  ]
}
