PORT=3001
TELEGRAM_TOKEN=
KITCHEN_CHAT_ID=
TELEGRAM_BOT_URL=https://t.me/SuperAnthbot
ALLOWED_ORIGINS=https://jelfferyduran.github.io
TAX_RATE=0
N8N_WEBHOOK_URL=
WHATSAPP_WEBHOOK=
MENU_DATA_PATH=

# ── Pricing Hub / invoice pipeline ────────────────────────────────────────────
# Operator token for server-to-server pricing reads (cannot approve a price).
PRICING_MANAGER_TOKEN=
# Hermes calculator key. Calculate-only; never reaches a write path.
PRICING_AGENT_KEY=
# Telegram chats allowed to use /price and /caseprice (comma separated).
PRICING_TELEGRAM_CHAT_IDS=
HERMES_CHAT_ID=
# ── Invoice reading (OCR) ─────────────────────────────────────────────────────
# A configured webhook wins: setting this URL is an explicit choice of reader.
# Point it at server/ocr-webhook.js, a self-hosted Tesseract/PaddleOCR box, or
# any service speaking the PR #32 multipart contract.
PRICING_OCR_WEBHOOK_URL=
PRICING_OCR_WEBHOOK_TOKEN=
# With no webhook URL, the app server calls Gemini Flash itself using a FREE
# Google AI Studio key — nothing extra to deploy.
# NOTE: Google's free tier may use submitted content to improve their products.
# Invoices are internal documents. Use the paid tier, or a local reader behind
# the webhook above, if that is not acceptable.
# With neither configured, scans are still stored privately and entered by hand.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# There are two ways to run the reader, and GEMINI_API_KEY serves both:
#   a) In-process (server/pricing-ocr.js) — the app server calls Gemini itself.
#      Nothing extra to deploy. Used when no webhook URL is configured.
#   b) Standalone service (server/ocr-webhook.js) — run it separately and point
#      PRICING_OCR_WEBHOOK_URL at it. Adds OpenRouter as an alternative provider
#      and keeps the key off the app server. An explicitly configured webhook
#      URL always wins, so setting one is how you choose this path.
OPENROUTER_API_KEY=
# Vision model for the standalone webhook (default google/gemini-2.5-flash). For
# direct Gemini the provider/model prefix is stripped.
#   Run: OCR_PORT=8799 node server/ocr-webhook.js
OCR_MODEL=google/gemini-2.5-flash
OCR_PORT=8799

# ── Multi-channel invoice intake ──────────────────────────────────────────────
# Shared secret proving a submission came from the bot bridge. Without it the
# intake route answers 404 to everyone.
PRICING_INTAKE_BRIDGE_KEY=
# WhatsApp senders allowed to submit scans (comma separated; any common format).
PRICING_WHATSAPP_NUMBERS=
# Private Supabase Storage bucket holding invoice scans.
PRICING_INVOICE_BUCKET=pricing-invoices
# Server-side Supabase access. The SERVICE ROLE KEY IS SERVER-ONLY: it must never
# be given to browser code, the Telegram runtime, or a general-purpose VPS agent.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional override of the retail rule. Defaults to the AGENTS.md 1.70 rule.
PRICING_RETAIL_MULTIPLIER=1.70

# ── PaddleOCR (local, private — opt-in) ─────────────────────────────────────
# The preferred reader, but only when explicitly chosen: leave this blank and it
# is never used. Point it at the container's published port, or set a bare flag
# (1 / on / true) to mean the standard local container (http://localhost:8120).
# If the container is unreachable the scan falls through to the webhook and then
# to Gemini, so a stopped container degrades instead of failing every scan.
PRICING_PADDLE_URL=
PRICING_PADDLE_MODEL=
# Serve the static pricing hub from this server (1 = on).
PRICING_SERVE_STATIC=1
